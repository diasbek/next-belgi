# Belgi.ai — copy to .env.local and fill required values.
# Never commit .env.local.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://belgi.nocode.uz

NEXT_PUBLIC_SUPABASE_URL=https://yfslkvdnnlbbuqriyfcu.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional (alternative to anon for password-grant login)
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only — Dashboard → Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=images

SECRETS_MASTER_KEY=
SESSION_SECRET=
OTP_PEPPER=

# ---------------------------------------------------------------------------
# Optional — site / SEO / analytics
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_TELEGRAM_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_YM_ID=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_YANDEX_SITE_VERIFICATION=

# ---------------------------------------------------------------------------
# Optional — trademark check upstream (mock if empty)
# ---------------------------------------------------------------------------
BELGI_CHECK_API_URL=
BELGI_CHECK_API_KEY=

# ---------------------------------------------------------------------------
# Optional — Adliya registry import (`npm run import:trademarks`)
# ---------------------------------------------------------------------------
ADLIYA_API_BASE=https://api-ip.adliya.uz
ADLIYA_ACCESS_TOKEN=
ADLIYA_PAGE_SIZE=100
ADLIYA_IMPORT_DELAY_MS=120
ADLIYA_DETAIL_DELAY_MS=300
